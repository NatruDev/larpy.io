# Copy this file to .env and fill in the values from your Supabase project:
# Project Settings > API (or the "Connect" button on the project page).
#
# Anything starting with EXPO_PUBLIC_ is bundled into the app and visible to users.
# The publishable key (or legacy "anon" key) is meant to be public. Row-level security protects the data.
# Never put the secret / service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
